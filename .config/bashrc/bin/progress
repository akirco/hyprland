#!/usr/bin/env bash

tput civis
trap "tput cnorm; echo; exit" EXIT

draw_progress() {
    local offset=$1
    local percent=$2
    local label=$3

    # --- 核心修改：动态计算宽度 ---
    local term_width
    term_width=$(tput cols)
    # 预留空间给标签、空格、括号和百分比 (例如: " (1/3) 检查密钥 [###] 100%")
    # 标签长度 + 括号和空格(约 7 个字符) + 百分比(4个字符)
    local reserved=12
    local label_len=${#label}
    local bar_size=$((term_width - label_len - reserved))

    # 容错处理：如果窗口太窄，至少给 10 个空格
    [[ $bar_size -lt 10 ]] && bar_size=10

    local filled=$((percent * bar_size / 100))
    local bar
    bar=$(printf "%${filled}s" | tr ' ' '#')

    tput sc
    tput cuu "$offset"
    # \e[K 用于清除从光标到行尾的内容，防止残影
    printf "\r\e[K%s [%-${bar_size}s] %d%%" "$label" "$bar" "$percent"
    tput rc
}

# --- 初始化阶段 ---
echo "(1/3) 等待中..."
echo "(2/3) 等待中..."
echo "(3/3) 等待中..."

# --- 更新阶段 ---
for i in {1..100}; do
    draw_progress 3 "$i" "(1/3) 检查密钥"

    p2=$((i * 2))
    draw_progress 2 "$(( p2 > 100 ? 100 : p2 ))" "(2/3) 校验数据"

    draw_progress 1 "$i" "(3/3) 正在安装"

    sleep 0.05
done

# 确保光标回到最后一行之后
echo -e "\n全部操作已完成！"
