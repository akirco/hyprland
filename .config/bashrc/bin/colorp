#!/usr/bin/env bash

tput civis
trap "tput cnorm; echo; exit" EXIT

draw_progress() {
    local offset=$1
    local percent=$2
    local label=$3

    local term_width
    term_width=$(tput cols)

    local reserved=15
    local bar_size=$((term_width - ${#label} - reserved))
    [[ $bar_size -lt 10 ]] && bar_size=10

    local filled=$((percent * bar_size / 100))
    local empty=$((bar_size - filled))

    local colored_bar=""
    local j
    for ((j=0; j<filled; j++)); do
        local rand_color
        rand_color=$((RANDOM % 216 + 16))
        colored_bar="${colored_bar}\e[38;5;${rand_color}m=\e[0m"
    done

    local bar_empty
    bar_empty=$(printf "%${empty}s")

    tput sc
    tput cuu "$offset"
    printf "\r\e[K%s [%b%s] %d%%" "$label" "$colored_bar" "$bar_empty" "$percent"
    tput rc
}


echo "(1/3) 准备中..."
echo "(2/3) 准备中..."
echo "(3/3) 准备中..."

for i in {1..100}; do
    draw_progress 3 "$i" "(1/3) 扫描文件"

    p2=$((i * 2))
    draw_progress 2 "$(( p2 > 100 ? 100 : p2 ))" "(2/3) 上传数据"

    draw_progress 1 "$i" "(3/3) 同步配置"

    sleep 0.05
done

echo -e "\n\e[1;32m✨ 任务全部达成，色彩斑斓！\e[0m"
