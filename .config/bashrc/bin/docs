#!/bin/bash
#!/bin/bash

# 配置
CACHE_DIR="$HOME/.cache/devdoc"
DOCS_JSON="$CACHE_DIR/docs.json"
DOCSETS_DIR="$CACHE_DIR/docsets"

# 确保缓存目录存在
mkdir -p "$CACHE_DIR" "$DOCSETS_DIR"

# 用户代理
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 检查依赖
check_dependencies() {
    local missing=()

    for cmd in curl jq fzf; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}错误：缺少以下核心依赖:${NC}"
        for cmd in "${missing[@]}"; do
            echo "  - $cmd"
        done
        echo -e "\n安装命令:"
        echo "  Ubuntu/Debian: sudo apt install ${missing[*]}"
        echo "  macOS: brew install ${missing[*]}"
        exit 1
    fi
}

# 获取文档列表
fetch_docs_list() {
    echo -e "${YELLOW}正在获取文档列表...${NC}"

    curl -sL "https://devdocs.io/docs.json" \
        -H "User-Agent: $USER_AGENT" \
        -H "Accept-Encoding: gzip" \
        --compressed \
        -o "$DOCS_JSON"

    if [ $? -ne 0 ]; then
        echo -e "${RED}错误：curl命令执行失败${NC}"
        return 1
    fi

    if [ ! -s "$DOCS_JSON" ]; then
        echo -e "${RED}错误：获取的文档列表为空${NC}"
        return 1
    fi

    if ! jq empty "$DOCS_JSON" 2>/dev/null; then
        echo -e "${RED}错误：获取的数据不是有效的JSON格式${NC}"
        return 1
    fi

    local count
    count=$(jq '. | length' "$DOCS_JSON" 2>/dev/null)
    echo -e "${GREEN}成功获取 $count 个文档${NC}"
    return 0
}

# 获取文档信息
get_doc_info() {
    local slug="$1"
    jq -r ".[] | select(.slug == \"$slug\")" "$DOCS_JSON" 2>/dev/null
}

# 下载文档数据库
download_doc_db() {
    local slug="$1"
    local doc_info
    doc_info=$(get_doc_info "$slug")

    if [ -z "$doc_info" ]; then
        echo -e "${RED}错误：找不到文档 '$slug'${NC}"
        return 1
    fi

    local release
    release=$(echo "$doc_info" | jq -r '.release // "latest"')

    local versioned_slug="${slug}~${release}"
    local doc_dir="$DOCSETS_DIR/$versioned_slug"
    local db_file="$doc_dir/db.json"
    local index_file="$doc_dir/index.json"

    if [ -f "$db_file" ] && [ -f "$index_file" ]; then
        echo -e "${BLUE}文档 '$slug' 版本 '$release' 已存在，跳过下载${NC}"
        return 0
    fi

    mkdir -p "$doc_dir"

    local mtime
    mtime=$(echo "$doc_info" | jq -r '.mtime // empty')
    if [ -z "$mtime" ]; then
        mtime=$(date +%s)
    fi

    local doc_name
    doc_name=$(echo "$doc_info" | jq -r '.name // empty')
    echo -e "${CYAN}正在下载文档: $doc_name ($release)${NC}"

    echo -e "${YELLOW}下载数据库中...${NC}"
    curl -sL "https://documents.devdocs.io/$slug/db.json?$mtime" \
        -H "User-Agent: $USER_AGENT" \
        -H "Accept-Encoding: gzip" \
        --compressed \
        -o "$db_file"

    if [ $? -ne 0 ] || [ ! -s "$db_file" ] || ! jq empty "$db_file" 2>/dev/null; then
        echo -e "${RED}错误：数据库下载失败或格式无效${NC}"
        rm -f "$db_file"
        return 1
    fi

    echo -e "${YELLOW}下载索引中...${NC}"
    curl -sL "https://documents.devdocs.io/$slug/index.json?$mtime" \
        -H "User-Agent: $USER_AGENT" \
        -H "Accept-Encoding: gzip" \
        --compressed \
        -o "$index_file"

    if [ $? -ne 0 ] || [ ! -s "$index_file" ] || ! jq empty "$index_file" 2>/dev/null; then
        echo -e "${RED}错误：索引下载失败或格式无效${NC}"
        rm -f "$index_file"
        return 1
    fi

    echo -e "${GREEN}✅ 文档 '$doc_name' ($release) 下载完成${NC}"
    return 0
}

# 查找已下载的文档版本
find_doc_version() {
    local slug="$1"
    local versions=()

    while IFS= read -r dir; do
        if [ -d "$dir" ] && [ -f "$dir/db.json" ] && [ -f "$dir/index.json" ]; then
            local version=$(basename "$dir")
            version="${version##*~}" 
            versions+=("$version")
        fi
    done < <(find "$DOCSETS_DIR" -maxdepth 1 -type d -name "${slug}~*" 2>/dev/null)

    if [ ${#versions[@]} -eq 0 ]; then
        return 1
    elif [ ${#versions[@]} -eq 1 ]; then
        echo "${slug}~${versions[0]}"
        return 0
    else
        echo -e "${YELLOW}找到多个版本:${NC}"
        for i in "${!versions[@]}"; do
            echo "$((i+1)). ${versions[$i]}"
        done
        read -p "选择版本 (1-${#versions[@]}): " choice
        if [[ $choice =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#versions[@]} ]; then
            echo "${slug}~${versions[$((choice-1))]}"
            return 0
        else
            echo -e "${RED}无效选择${NC}"
            return 1
        fi
    fi
}

# 渲染 HTML 内容到终端
render_html() {
    local html="$1"
    if command -v w3m &> /dev/null; then
        echo "$html" | w3m -T text/html -I utf-8 -O utf-8 -cols "$(tput cols)"
    elif command -v lynx &> /dev/null; then
        echo "$html" | lynx -dump -stdin -width="$(tput cols)"
    else
        echo "$html" | sed 's/<[^>]*>//g' | sed '/^$/N;/^\n$/D'
    fi
}

# 浏览文档内容
browse_doc() {
    local versioned_slug="$1"
    local doc_dir="$DOCSETS_DIR/$versioned_slug"
    local db_file="$doc_dir/db.json"
    local index_file="$doc_dir/index.json"

    if [ ! -f "$db_file" ] || [ ! -f "$index_file" ]; then
        echo -e "${RED}错误：文档 '$versioned_slug' 未下载${NC}"
        return 1
    fi

    local entries
    if ! entries=$(jq -r '
        [.. | objects | select(.name and (.path // .slug))] 
        | unique 
        | .[] 
        | [.name, (.path // .slug)] 
        | @tsv
    ' "$index_file" 2>/dev/null); then
        echo -e "${RED}错误：无法解析索引文件 (可能格式损坏)${NC}"
        return 1
    fi

    if [ -z "$entries" ]; then
        echo -e "${RED}错误：索引文件为空或未提取到有效条目${NC}"
        return 1
    fi

    while true; do
        local result
        result=$(echo "$entries" | fzf \
            --height 40% \
            --reverse \
            --with-nth=1 \
            --delimiter=$'\t' \
            --prompt="搜索文档内容: " \
            --header="📚 按 Enter 查看 | ESC 返回主菜单" \
            --expect=esc,enter)

        local key=$(echo "$result" | head -n1)
        local selected_entry=$(echo "$result" | tail -n +2)

        if [ -z "$selected_entry" ] || [ "$key" = "esc" ]; then
            break
        fi

        local path=$(echo "$selected_entry" | cut -f2)
        local name=$(echo "$selected_entry" | cut -f1)

        if [ -n "$path" ]; then
            # 🔥 核心修复：DevDocs 的 path 经常带有 # 锚点 (如 assert#assertvalue-message)
            # 但 db.json 中的 key 只有基础路径 (如 assert)，必须截断 # 后面的部分
            local base_path="${path%%#*}"

            local content=$(jq -r --arg bp "$base_path" '.[$bp]' "$db_file" 2>/dev/null)

            # 智能匹配 db.json 中的键名 (补全 .html 或 /index.html)
            if [ -z "$content" ] || [ "$content" = "null" ]; then
                content=$(jq -r --arg p "${base_path}.html" '.[$p]' "$db_file" 2>/dev/null)
            fi
            if [ -z "$content" ] || [ "$content" = "null" ]; then
                content=$(jq -r --arg p "${base_path}/index.html" '.[$p]' "$db_file" 2>/dev/null)
            fi
            # 终极兜底：模糊匹配
            if [ -z "$content" ] || [ "$content" = "null" ]; then
                local match_key=$(jq -r --arg bp "$base_path" 'keys[] | select(contains($bp))' "$db_file" 2>/dev/null | head -1)
                if [ -n "$match_key" ]; then
                    content=$(jq -r --arg k "$match_key" '.[$k]' "$db_file" 2>/dev/null)
                fi
            fi

            if [ -n "$content" ] && [ "$content" != "null" ]; then
                echo -e "${CYAN}显示: $name ($path)${NC}\n"
                local rendered_text=$(render_html "$content")
                
                if command -v bat &> /dev/null; then
                    echo "$rendered_text" | bat --language=markdown --style=plain --paging=always
                else
                    echo "$rendered_text" | less -R -F -X -K
                fi
            else
                echo -e "${RED}错误：在数据库中找不到 '$base_path' 的内容${NC}"
                read -p "按 Enter 继续..."
            fi
        else
            echo -e "${RED}错误：无法提取路径${NC}"
            read -p "按 Enter 继续..."
        fi
    done
}

# 生成文档列表显示
generate_docs_list() {
    local installed_slugs=()
    
    if [ -d "$DOCSETS_DIR" ]; then
        for dir in "$DOCSETS_DIR"/*; do
            if [ -d "$dir" ] && [ -f "$dir/db.json" ] && [ -f "$dir/index.json" ]; then
                local versioned_slug=$(basename "$dir")
                local slug="${versioned_slug%%~*}"
                local release="${versioned_slug##*~}"

                local info=$(jq -r ".[] | select(.slug == \"$slug\") | .name" "$DOCS_JSON" 2>/dev/null)
                if [ -z "$info" ]; then
                    info="$slug"
                fi

                local size=$(du -sh "$dir" 2>/dev/null | cut -f1)

                printf "✅\t%s\t%s\t%s\t%s\n" "$info" "$release" "$size" "$versioned_slug"
                installed_slugs+=("$slug")
            fi
        done
    fi

    if [ -f "$DOCS_JSON" ]; then
        local installed_json=$(printf '%s\n' "${installed_slugs[@]}" | jq -R . | jq -s .)
        jq -r --argjson installed "$installed_json" '
            .[] | select([.slug] | inside($installed) | not) |
            ["❌", .name, (.release // "N/A"), ((.db_size/1024/1024) | floor | tostring + " MB"), .slug] | @tsv
        ' "$DOCS_JSON" 2>/dev/null
    fi
}

# 显示状态信息
show_status() {
    local installed_count=0
    if [ -d "$DOCSETS_DIR" ]; then
        installed_count=$(find "$DOCSETS_DIR" -name "db.json" -type f 2>/dev/null | wc -l)
    fi

    local total_count=0
    if [ -f "$DOCS_JSON" ]; then
        total_count=$(jq '. | length' "$DOCS_JSON" 2>/dev/null || echo 0)
    fi

    echo -e "${PURPLE}📊 状态: ${installed_count}/${total_count} 个文档已安装${NC}"
    echo -e "${BLUE}🔄 Ctrl+R: 刷新列表 | 🔍 输入关键词搜索 | 📥 Ctrl+D: 下载 | ❌ Ctrl+Q: 退出${NC}"
}

# 主文档选择界面
main_doc_selector() {
    while true; do
        if [ ! -f "$DOCS_JSON" ]; then
            fetch_docs_list || exit 1
        fi

        clear
        echo -e "${GREEN}╔══════════════════════════════════════════╗${NC}"
        echo -e "${GREEN}║         DevDoc 终端查看器 v2.0          ║${NC}"
        echo -e "${GREEN}╚══════════════════════════════════════════╝${NC}"
        echo ""
        show_status
        echo ""

        local result
        result=$(generate_docs_list | fzf \
            --height 80% \
            --reverse \
            --with-nth=1,2,3,4 \
            --delimiter=$'\t' \
            --prompt="🔍 搜索文档: " \
            --header="✅ = 已安装 | ❌ = 未安装 | 回车: 查看 | Ctrl+D: 下载 | Ctrl+R: 刷新 | Ctrl+Q: 退出" \
            --expect=ctrl-d,ctrl-r,ctrl-q,enter)

        local key=$(echo "$result" | head -n1)
        local selected=$(echo "$result" | tail -n +2)

        if [ -z "$selected" ] && [ "$key" != "ctrl-r" ]; then
            echo -e "${BLUE}👋 再见!${NC}"
            exit 0
        fi

        local identifier=$(echo "$selected" | awk -F'\t' '{print $NF}')

        case "$key" in
            ctrl-r)
                fetch_docs_list
                echo -e "${GREEN}文档列表已刷新${NC}"
                sleep 1
                ;;
            ctrl-d)
                if [ -n "$identifier" ]; then
                    local slug="${identifier%%~*}"
                    echo ""
                    download_doc_db "$slug"
                    echo ""
                    echo -e "${YELLOW}按任意键继续...${NC}"
                    read -n 1 -s
                fi
                ;;
            enter)
                if [ -z "$identifier" ]; then
                    continue
                fi

                if [[ "$identifier" == *~* ]]; then
                    browse_doc "$identifier"
                else
                    local versioned_slug
                    if versioned_slug=$(find_doc_version "$identifier"); then
                        browse_doc "$versioned_slug"
                    else
                        echo ""
                        echo -e "${YELLOW}文档 '$identifier' 未安装，是否下载？${NC}"
                        read -r response
                        if [[ "$response" =~ ^[Yy]$ ]]; then
                            download_doc_db "$identifier"
                            if [ $? -eq 0 ]; then
                                local new_release=$(get_doc_info "$identifier" | jq -r '.release // "latest"')
                                browse_doc "${identifier}~${new_release}"
                            else
                                echo -e "${YELLOW}按任意键继续...${NC}"
                                read -n 1 -s
                            fi
                        fi
                    fi
                fi
                ;;
        esac
    done
}

# 主函数
main() {
    check_dependencies

    if [ ! -f "$DOCS_JSON" ]; then
        fetch_docs_list || exit 1
    fi

    main_doc_selector
}

main
