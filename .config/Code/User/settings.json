{
  "workbench.editor.highlightModifiedTabs": true,
  "telemetry.telemetryLevel": "off",
  "workbench.startupEditor": "none",
  "biome.lsp.bin": "/usr/bin/biome",
  "rust-analyzer.checkOnSave": true,
  "window.autoDetectHighContrast": false,
  "npm.packageManager": "auto",
  "editor.fontSize": 20,
  "window.zoomLevel": 1.6,
  "editor.fontFamily": "'JetBrainsMono Nerd Font','Hack Nerd Font','Fira Code Script','Delugia PL Mono','FiraCode Nerd Font Mono Ret','Delugia PL Mono',Consolas",
  // "editor.fontFamily": "'Monofur Nerd Font','JetBrainsMonoNL Nerd Font','JetBrainsMono Nerd Font','Hack Nerd Font','Fira Code Script','Delugia PL Mono','FiraCode Nerd Font Mono Ret','Delugia PL Mono',Consolas",
  "editor.fontLigatures": true,
  "editor.autoIndent": "full",
  "editor.cursorBlinking": "expand",
  "editor.cursorStyle": "line",
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyTabStops": true,
  "editor.tabCompletion": "on",
  "editor.suggest.insertMode": "replace",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.tabSize": 2,
  "editor.suggestSelection": "first",
  "editor.largeFileOptimizations": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.sortImports": "explicit"
  },
  "terminal.integrated.scrollback": 100000,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "yaml.extension.recommendations": false,
  "yaml.format.singleQuote": true,
  "window.newWindowProfile": "Default",
  "editor.defaultFormatter": "biomejs.biome",
  "diffEditor.maxComputationTime": 0,
  "editor.minimap.showSlider": "always",
  "chat.mcp.autostart": "never",
  "chat.mcp.gallery.enabled": false,
  "http.proxy": "http://127.0.0.1:7890",
  "http.proxyStrictSSL": false,
  "http.proxySupport": "override",
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.profiles.windows": {
    "pwsh": {
      "path": "E:\\apps\\scoop\\apps\\pwsh\\current\\pwsh.exe",
      "args": [
        "-Nologo"
      ]
    },
  },
  "terminal.integrated.defaultProfile.windows": "pwsh",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontSize": 18,
  "editor.fontWeight": "500",
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.fontFamily": "'JetBrainsMonoNL Nerd Font Mono'",
  "terminal.integrated.hideOnStartup": "always",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "redhat.telemetry.enabled": false,
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "onFocusChange",
  "git.autofetch": true,
  "explorer.confirmPasteNative": false,
  "editor.accessibilitySupport": "off",
  "window.dialogStyle": "custom",
  "workbench.editor.closeOnFileDelete": true,
  "chat.agent.enabled": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      80
    ],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescript": true,
    "json": true,
    "yaml": false,
    "shellscript": true,
    "typescriptreact": true,
    "rust": false
  },
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.copilotDebugCommand.enabled": false,
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Bearded Theme Black & Emerald",
  "workbench.preferredDarkColorTheme": "Bearded Theme Void",
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": [
      {
        "name": "envKeys",
        "scope": "string.quoted.single.ini,constant.numeric.ini,string.quoted.double.ini",
        "settings": {
          "foreground": "#19354900"
        }
      },
      {
        "scope": [
          "comment",
          "storage.modifier",
          "entity.other.attribute-name",
          "fenced_code.block.language.markdown",
          "storage.type.function.solidity",
          "storage.type.function",
          "keyword"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "storage.type.class",
          "constant",
          "support.class.builtin.js"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "entity.name.section.markdown"
        ],
        "settings": {
          "fontStyle": "italic bold"
        }
      },
      {
        "scope": [
          "invalid",
          "keyword.operator",
          "constant.numeric.css",
          "keyword.other.unit.px.css",
          "constant.numeric.decimal.js",
          "constant.numeric.json",
          "comment.block",
          "entity.other.attribute-name.class.css"
        ],
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },
  "editor.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.editor.empty.hint": "hidden",
  "ProjectManager.root": "/home/neil/Projects",
  "ProjectManager.cleanerPatterns": [
    "**/node_modules",
    "**/target",
    "**/.venv",
    "**/venv"
  ],
  "ProjectManager.scaffolds": {
    "createVite": "pnpm dlx create-vite .",
    "createViteExtra": "pnpm dlx create-vite-extra .",
    "createNextApp": "pnpm dlx create-next-app@latest .",
    "createAstro": "pnpm dlx create-astro .",
    "createElectronVite": "npm create @quick-start/electron .",
    "createTauri": "pnpm dlx create-tauri-app .",
    "createWxt": "pnpm dlx wxt@latest init .",
    "createNestjs": "pnpm dlx @nestjs/cli new .",
    "createTurbo": "pnpm dlx create-turbo@latest .",
    "cargoInit": "cargo init .",
    "cloneTSUP_NodeLib": "git clone https://github.com/akirco/template-node-lib-tsup.git .",
    "createHono": "pnpm create hono@latest",
    "createink": "pnpm dlx create-ink-app . --typescript"
  },
  "http.noProxy": [
    "registry.npmmirror.com",
    "repo.huaweicloud.com",
    "r.cnpmjs.org",
    "mirrors.tencent.com"
  ],
  "python.analysis.typeCheckingMode": "standard",
  "editor.overtypeCursorStyle": "line",
  "terminal.integrated.enableImages": true,
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev": true,
    "https://developer.microsoft.com/json-schemas/": true,
